<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cornerstoneplatform_wizard_form" model="ir.ui.view">
        <field name="name">cornerstoneplatform.wizard.form</field>
        <field name="model">cornerstoneplatform.wizard</field>
        <field name="arch" type="xml">
            <form string="Import CornerstonePlatform Donations">
                <group>
                    <field name="month"/>
                </group>
                <footer>
                    <button name="action_create_move" type="object" string="Create Entry" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cornerstoneplatform_wizard" model="ir.actions.act_window">
        <field name="name">Import from Cornerstone</field>
        <field name="group_ids" eval="[(6, 0, [ref('account.group_account_manager')])]"/>
        <field name="res_model">cornerstoneplatform.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cornerstoneplatform</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Cornerstone Platform" name="cornerstoneplatform_settings">
                    <setting string="GraphQL URL" help="URL of the CornerstonePlatform GraphQL endpoint.">
                        <field name="cornerstoneplatform_graphql_url" placeholder="https://example.com/_graphql"/>
                    </setting>
                    <setting string="Session Cookie" help="Authenticated CSNSESSID cookie value.">
                        <field name="cornerstoneplatform_cookie" password="True"/>
                    </setting>
                    <setting string="Debit Account Code" help="Odoo account code used for the debit line.">
                        <field name="cornerstoneplatform_debit_account_code"/>
                    </setting>
                    <setting string="Journal Code" help="Code of the general journal used for the entry.">
                        <field name="cornerstoneplatform_journal_code"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>